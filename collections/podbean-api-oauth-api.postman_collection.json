      "item": [
        {
          "id": "e287ea50-70b1-476c-9b79-0a6b77a99ea0",
          "name": "Request an access token",
          "request": {
            "name": "Request an access token",
            "description": {
              "content": "OAuth 2.0 token endpoint. Use HTTP Basic with client_id /\nclient_secret and POST `grant_type=client_credentials`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>"
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>"
                }
              ]
            }
          },
          "response": [
            {
              "id": "626c7441-e6e1-46c3-8be3-ed3df44b7a10",
              "name": "Access token issued",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "key": "code",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "key": "redirect_uri",
                      "value": "<uri>"
                    },
                    {
                      "disabled": false,
                      "key": "refresh_token",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"string\",\n  \"expires_in\": 7596,\n  \"scope\": \"string\"\n}",
              "cookie": [],
