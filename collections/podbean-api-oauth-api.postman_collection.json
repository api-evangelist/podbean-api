              "content": "Returns a map of per-podcast access tokens for accounts with\nmultiple podcasts under the same Podbean app.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth",
                "multiplePodcastsToken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
